# Postgres connection string. Poolers (Supabase :6543, Neon "-pooler") are detected automatically.
DATABASE_URL=postgres://opentab:opentab@localhost:5432/opentab
# Direct/session connection for migrations and LISTEN (optional; defaults to DATABASE_URL)
DATABASE_URL_UNPOOLED=
# Public base URL of the web app, including any sub-path (used in emails, magic links, QR codes)
APP_URL=http://localhost:3000
# Serve under a sub-path, e.g. /opentab (build time). Leave empty for the domain root.
BASE_PATH=
# Live updates: sse (long-running server) | poll (serverless). Default: sse, or poll on Vercel.
LIVE_MODE=
# Background jobs: worker (pg-boss + apps/worker) | inline (in the web process). Default: worker, or inline on Vercel.
JOB_MODE=
# Protects /api/cron/tick (scheduled publishes when JOB_MODE=inline)
CRON_SECRET=
# 32+ random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# Email (optional). Without SMTP_URL, emails are printed to the worker log.
SMTP_URL=
EMAIL_FROM="OpenTab <no-reply@opentab.local>"
# Web Push (optional). Generate with `pnpm --filter @opentab/worker vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@opentab.local
